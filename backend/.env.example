# Google Cloud project — Firestore uses the project from Application Default
# Credentials. On Cloud Run this is injected by the metadata server. Locally,
# run `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS.
GCP_PROJECT_ID=bonsai-feed-filter
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=bonsai_posts

# Google OAuth client id used in extension/manifest.json (for ID token audience check)
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# CORS — extension origin: chrome-extension://<EXTENSION_ID>
# Add multiple comma-separated if you have more than one.
ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Port is set by Cloud Run; locally defaults to 8000 via the run command.
PORT=8000
