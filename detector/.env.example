# Hugging Face token (required for gated repos).
HF_TOKEN=hf_...

# HuggingFace checkpoint id to load. Required — the service is model-agnostic
# and refuses to serve `/detect` without one. Must expose a sequence
# classification head; see model.py for how different head shapes are mapped
# to {AI, Human} with confidence.
AI_WRITING_DETECTION_MODEL_ID=

# Comma-separated list of chrome-extension:// origins allowed to call.
# Leave blank to permit any origin during experimental testing.
ALLOWED_ORIGINS=
